{
  // Deliberately minimal. Cloudflare's own docs for @cloudflare/vite-plugin
  // (see vite.config.ts) say NOT to set assets.directory here — the plugin
  // configures that automatically from the Vite build output. We've also
  // left out assets.not_found_handling entirely: this app has zero
  // client-side routes right now (App.tsx switches screens via React state,
  // no router, everything lives at one URL), so SPA fallback isn't needed
  // yet, and "single-page-application" is exactly the value that hits a
  // confirmed, currently-open Cloudflare platform bug — their own
  // infinite-loop validator false-positives on SPA fallback rules,
  // including their own auto-generated config. See:
  // https://github.com/cloudflare/workers-sdk/issues/10992 (open)
  // https://github.com/cloudflare/workers-sdk/issues/11824 (closed; the
  // confirmed workaround, once real routing is added and this is needed
  // again, is serving the fallback from a renamed file like
  // `_index.html`, not "single-page-application" directly).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "electronic-displaykit",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"]
}
